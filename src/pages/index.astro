---
// Gerado a partir de: agape-landing-v4 (2).html
import Base from "../layouts/Base.astro";
import config from "../../config.json";
import Img from "../components/ui/Img.astro";
import Video from "../components/ui/Video.astro";
import StaticMap from "../components/ui/StaticMap.astro";
import LeadForm from "../components/forms/LeadForm.astro";
import "../styles/agape-landing-v4-2.css";
import logoWaIcon from "../assets/images/logo-whatsapp.png";
import fundoWaUrl from "../assets/images/fundo-whatsapp.avif?url";
import iconeWaUrl from "../assets/images/icone-whatsapp.svg?url";
---

<Base
  title="Ágape Celebration & Convention — Casamentos"
  description="Um cenário à beira-mar para casamentos sofisticados e inesquecíveis no litoral paulista."
  ogImage="/images/og-default.jpg"
>
  <!-- ═══ NAV ═══ -->
  <nav class="nav" id="nav">
    <div class="nav__logo">
      <img
        src="/images/logo-areia.png"
        alt="Ágape Celebration & Convention"
        class="nav__logo-img nav__logo--areia"
        height="40"
      />
      <img
        src="/images/logo-dourado.png"
        alt=""
        class="nav__logo-img nav__logo--dourado"
        height="40"
        aria-hidden="true"
      />
    </div>
    <a href="#contato" class="btn btn--nav">Solicite orçamento</a>
  </nav>

  <!-- ═══ HERO — limpo, título em 2 linhas, endereço ═══ -->
  <section class="hero" id="inicio">
    <div class="hero__bg">
      <Img src="hero-cerimonia-praia.jpg" alt="Vista para o mar — Ágape Celebration" priority />
      <div class="hero__overlay"></div>
    </div>
    <div class="hero__content fade-in">
      <p class="hero__eyebrow">Destination Wedding</p>
      <h1 class="hero__title">
        Um cenário à beira-mar para casamentos sofisticados e inesquecíveis
      </h1>
    </div>
    <div class="hero__scroll-hint">
      <div class="hero__scroll-line"></div>
    </div>
  </section>

  <!-- ═══ AUTORIDADE ═══ -->
  <section class="autoridade reveal" id="autoridade">
    <div class="container container--narrow">
      <span class="eyebrow eyebrow--dark">Por que Ágape?</span>
      <h2>
        Experiência completa com<br /><span class="txt-gold"
          ><i>cenários paradisíacos</i>
        </span>
      </h2>
      <div class="ornament"></div>
      <p class="lead">
        Cada detalhe do Ágape Celebration foi pensado para proporcionar
        exclusividade, conforto e fluidez em todos os momentos do evento, da
        recepção dos convidados à experiência dos noivos durante a hospedagem.
      </p>
    </div>
    <div class="container autoridade__blocos">
      <div class="bloco reveal-stagger">
        <div class="bloco__icon">
          <svg viewBox="0 0 32 32" fill="none"
            ><circle cx="16" cy="9" r="3.5" stroke="currentColor" stroke-width="1.4"></circle
            ><line x1="16" y1="3" x2="16" y2="5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></line
            ><line x1="16" y1="13" x2="16" y2="15" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></line
            ><line x1="8" y1="9" x2="10" y2="9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></line
            ><line x1="22" y1="9" x2="24" y2="9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></line
            ><path d="M4 24c3-3 5-3 8 0s5 3 8 0 5-3 8 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path
            ><path d="M4 28c3-3 5-3 8 0s5 3 8 0 5-3 8 0" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" opacity=".4"></path>
          </svg>
        </div>
        <h3>Praia praticamente exclusiva</h3>
        <p>
          Acesso privilegiado à beira-mar, reservado para os seus convidados em meio às paisagens mais belas do litoral paulista.
        </p>
      </div>
      <div class="bloco reveal-stagger">
        <div class="bloco__icon">
          <svg viewBox="0 0 32 32" fill="none"
            ><path
              d="M6 8h20M6 16h20M6 24h12"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"></path>
          </svg>
        </div>
        <h3>Estrutura integrada para evento e hospedagem</h3>
        <p>
          Espaços para cerimônia, festa e acomodação reunidos em um único
          endereço, eliminando deslocamentos e garantindo fluidez.
        </p>
      </div>
      <div class="bloco reveal-stagger">
        <div class="bloco__icon">
          <svg viewBox="0 0 32 32" fill="none"
            ><path d="M8 16v-4a8 8 0 0 1 16 0v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path
            ><rect x="5" y="16" width="5" height="7" rx="2.5" stroke="currentColor" stroke-width="1.4"></rect
            ><rect x="22" y="16" width="5" height="7" rx="2.5" stroke="currentColor" stroke-width="1.4"></rect
            ><path d="M27 23v1a4 4 0 0 1-4 4h-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
          </svg>
        </div>
        <h3>Atendimento personalizado</h3>
        <p>
          Uma equipe dedicada acompanha todas as etapas do planejamento, garantindo que cada detalhe aconteça exatamente como você sempre sonhou.
        </p>
      </div>
      <div class="bloco reveal-stagger">
        <div class="bloco__icon">
          <svg viewBox="0 0 32 32" fill="none"
            ><rect
              x="4"
              y="12"
              width="24"
              height="16"
              rx="2"
              stroke="currentColor"
              stroke-width="1.4"></rect><path
              d="M10 12V8a6 6 0 0 1 12 0v4"
              stroke="currentColor"
              stroke-width="1.4"></path><circle
              cx="16"
              cy="20"
              r="2"
              stroke="currentColor"
              stroke-width="1.4"></circle>
          </svg>
        </div>
        <h3>Ambiente reservado e sofisticado</h3>
        <p>
          Privacidade absoluta e uma atmosfera de sofisticação que transforma
          cada momento em uma memória permanente.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ EXPERIÊNCIA ═══ -->
  <section class="experiencia reveal" id="experiencia">
    <div class="container container--narrow">
      <span class="eyebrow">A celebração</span>
      <h2>
        Aqui, a <i>paisagem natural</i><br /><span class="txt-gold"
          >se torna parte da celebração.</span
        >
      </h2>
      <div class="ornament"></div>
      <p class="lead">
        Cerimônias frente ao mar, hospedagem para convidados, experiências prolongadas e a sensação de viver um destination wedding sem sair do litoral paulista.
      </p>
    </div>
    <div class="container experiencia__cards">
      <div class="exp-card reveal-stagger">
        <Img
          src="pre-wedding.jpg"
          alt="Espaço de making of e preparação da noiva"
          class="exp-card__img"
        />
        <div class="exp-card__body">
          <span class="exp-card__tag">Pré Wedding</span>
          <p>
            Ambientes reservados para o making of, ensaio fotográfico e preparação da noiva e madrinhas.
          </p>
        </div>
      </div>
      <div class="exp-card reveal-stagger">
        <Img
          src="cerimonia-pe-na-areia.jpg"
          alt="Cerimônia pé na areia à beira-mar"
          class="exp-card__img"
        />
        <div class="exp-card__body">
          <span class="exp-card__tag">Cerimônia pé na areia</span>
          <p>
            Cerimônias à beira-mar com estrutura integrada e vista privilegiada.
          </p>
        </div>
      </div>
      <div class="exp-card reveal-stagger">
        <Img
          src="destination-wedding.jpg"
          alt="Destination wedding — acomodações com vista para o mar"
          class="exp-card__img"
        />
        <div class="exp-card__body">
          <span class="exp-card__tag">Destination Wedding</span>
          <p>
            Acomodações sofisticadas para viver cada momento do casamento com
            calma, conforto e vista para o mar.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ ESTRUTURA — tipográfica, sem ícones ═══ -->
  <section class="estrutura reveal" id="estrutura">
    <div class="container container--narrow">
      <span class="eyebrow eyebrow--dark">Infraestrutura</span>
      <h2>
        <i>Celebração e hospedagem</i><br /><span class="txt-gold"
          >reunidas em um único cenário</span
        >
      </h2>
      <div class="ornament"></div>
      <p class="lead">
        O Ágape une estrutura para eventos de alto padrão com acomodações
        sofisticadas, oferecendo praticidade, conforto e exclusividade para
        noivos e convidados.
      </p>
    </div>
    <div class="container estrutura__grid">
      <div class="estrutura__item reveal-stagger" data-num="I">
        <span class="estrutura__label">Deck com vista para o mar</span>
      </div>
      <div class="estrutura__item reveal-stagger" data-num="II">
        <span class="estrutura__label">Suíte premium para os noivos</span>
      </div>
      <div class="estrutura__item reveal-stagger" data-num="III">
        <span class="estrutura__label">SPA da noiva</span>
      </div>
      <div class="estrutura__item reveal-stagger" data-num="IV">
        <span class="estrutura__label">Sala das madrinhas</span>
      </div>
      <div class="estrutura__item reveal-stagger" data-num="V">
        <span class="estrutura__label">Vista privilegiada para Ilha Bela</span>
      </div>
      <div class="estrutura__item reveal-stagger" data-num="VI">
        <span class="estrutura__label">Acessibilidade</span>
      </div>
      <div class="estrutura__item reveal-stagger" data-num="VII">
        <span class="estrutura__label">Fácil acesso</span>
      </div>
      <div class="estrutura__item reveal-stagger" data-num="VIII">
        <span class="estrutura__label">Estacionamento</span>
      </div>
    </div>
  </section>

  <!-- ═══ HOSPEDAGEM — mosaico ═══ -->
  <section class="hospedagem reveal" id="hospedagem">
    <div class="hospedagem__inner">
      <div class="hospedagem__text">
        <span class="eyebrow eyebrow--dark">Acomodações</span>
        <h2>
          <i>Conforto</i> pensado<br /><span class="txt-gold"
            >em cada detalhe</span
          >
        </h2>
        <p>
          Com estrutura integrada ao evento, a hospedagem permite viver cada
          momento com mais presença, leveza e conexão.
        </p>
      </div>
      <div class="hospedagem__mosaic">
        <div class="hospedagem__mosaic-item">
          <Img src="acomodacao-piscina.jpg" alt="Piscina e área de lazer beira-mar — Ágape" />
        </div>
        <div class="hospedagem__mosaic-item">
          <Img src="acomodacao-quarto.jpg" alt="Acomodação com vista para o mar — Ágape" />
        </div>
        <div class="hospedagem__mosaic-item">
          <Img src="acomodacao-quarto-vista.jpg" alt="Quarto com vista para o mar — Ágape" />
        </div>
        <div class="hospedagem__mosaic-item">
          <Img src="acomodacao-area-lazer.jpg" alt="Área de lazer e piscina — Ágape" />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ DEPOIMENTOS — claro e premium ═══ -->
  <section class="depoimentos reveal" id="depoimentos">
    <div class="container container--narrow">
      <span class="eyebrow eyebrow--dark">Depoimentos</span>
      <h2>
        <i>Hospitalidade que conquista</i><br /><span class="txt-gold"
          >hóspedes e convidados</span
        >
      </h2>
      <div class="ornament"></div>
      <p class="lead">
        A experiência oferecida pelo Ágape já é reconhecida pela excelência no
        atendimento, conforto e estrutura.
      </p>
    </div>
    <div class="container depoimentos__grid">
      <div class="depo reveal-stagger">
        <div class="depo__stars">★★★★★</div>
        <blockquote>"A piscina é ótima, com vista pro mar. Toda a roupa de cama, toalhas são de extrema qualidade. A limpeza estava impecável."</blockquote>
        <cite>— Aline</cite>
      </div>
      <div class="depo reveal-stagger">
        <div class="depo__stars">★★★★★</div>
        <blockquote>"Acomodação impecável. Tudo maravilhoso. Localização incrível com uma praia "particular"na frente do hotel. Vista maravilhosa, deck e local da piscina incriveis. Amamos e com certeza voltaremos."</blockquote>
        <cite>— Fernanda</cite>
      </div>
      <div class="depo reveal-stagger">
        <div class="depo__stars">★★★★★</div>
        <blockquote>"Experiência incrível. Funcionários muito atenciosos e prestativos. A estrutura do quarto e das áreas comuns são ótimas."</blockquote>
        <cite>— Leonardo</cite>
      </div>
      <div class="depo reveal-stagger">
        <div class="depo__stars">★★★★★</div>
        <blockquote>"Muito bom gosto na decoração e nos detalhes, roupa de cama maravilhosa, digno de um quarto 5 estrelas. Pé na areia, olhando pela janela do quarto parece que você está em Cruzeiro, praia privativa, com uma boa piscina."</blockquote>
        <cite>— Guilherme </cite>
      </div>
      <div class="depo reveal-stagger">
        <div class="depo__stars">★★★★★</div>
        <blockquote>"O lugar é muito bem estruturado, tudo muito novo e moderno. Fica em um excelente ponto da cidade, próximo a mercados e com acesso a uma praia maravilhosa de águas muito calmas."</blockquote>
        <cite>— Alline</cite>
      </div>
      <div class="depo reveal-stagger">
        <div class="depo__stars">★★★★★</div>
        <blockquote>"Muito organizado! A higiene é um diferencial! Todos muito solícitos quando precisamos. O local fica colado na praia e dá para desfrutar da piscina com vista para o mar!"</blockquote>
        <cite>— Tamires</cite>
      </div>
    </div>
  </section>

  <!-- ═══ GALERIA — mosaico com vídeo integrado ═══ -->
  <section class="galeria reveal" id="galeria">
    <div class="container container--narrow">
      <span class="eyebrow eyebrow--dark">Galeria</span>
      <h2>
        Inspire-se para viver<br /><span class="txt-gold"
          ><i>seu casamento nesse cenário</i>
        </span>
      </h2>
      <div class="ornament"></div>
    </div>
    <div class="galeria__grid">
      <!-- Linha 1: 3 fotos -->
      <div class="galeria__item">
        <Img src="galeria-01.jpg" alt="Foto da galeria Ágape 1" />
      </div>
      <div class="galeria__item">
        <Img src="galeria-02.jpg" alt="Foto da galeria Ágape 2" />
      </div>
      <div class="galeria__item">
        <Img src="galeria-03.jpg" alt="Foto da galeria Ágape 3" />
      </div>
      <!-- Linha 2+3: foto | vídeo portrait (rowspan 2) | foto -->
      <div class="galeria__item">
        <Img src="galeria-04.jpg" alt="Foto da galeria Ágape 4" />
      </div>
      <div class="galeria__item">
        <Img src="galeria-05.jpg" alt="Foto da galeria Ágape 5" />
      </div>
      <div class="galeria__item">
        <Img src="galeria-06.jpg" alt="Foto da galeria Ágape 6" />
      </div>
      <div class="galeria__item">
        <Img src="galeria-07.jpg" alt="Foto da galeria Ágape 7" />
      </div>
      <!-- Vídeo portrait posicionado por CSS em col 2, rows 2–3 -->
      <div class="galeria__video">
        <Video
          src="/videos/agape.mp4"
          poster="/images/video-poster.jpg"
          title="Espaço Ágape Celebration"
          description="Vídeo do espaço Ágape Celebration — casamentos à beira-mar em São Sebastião"
          uploadDate="2026-05-18"
          duration="PT2M"
        />
      </div>
    </div>
  </section>

  <!-- ═══ CONTATO ═══ -->
  <section class="contato reveal" id="contato">
    <div class="contato__inner">
      <div class="contato__text">
        <span class="eyebrow eyebrow--dark">Fale conosco</span>
        <h2>
          Vamos começar a planejar o<br /><i>casamento dos seus sonhos?</i>
        </h2>
        <div class="ornament" style="margin-left:0;"></div>
        <p>Preencha o formulário para receber nosso contato.</p>
      </div>
      <div class="contato__form-wrap">
        <LeadForm
          formId="lead-form"
          project="casamentos"
          submitUrl={config.forms["lead-form"].webhooks[0]}
          redirectUrl={config.forms["lead-form"].redirect_on_success}
          submitText="Solicitar Orçamento"
          honeypot
          fields={[
            {
              name: "nome",
              type: "text",
              label: "Nome",
              placeholder: "Seu nome completo",
              required: true,
              full: true,
            },
            {
              type: "row",
              fields: [
                {
                  name: "telefone",
                  type: "tel",
                  label: "Telefone",
                  placeholder: "(00) 00000-0000",
                  required: true,
                },
                {
                  name: "email",
                  type: "email",
                  label: "E-mail",
                  placeholder: "seu@email.com",
                  required: true,
                },
              ],
            },
            {
              type: "row",
              fields: [
                {
                  name: "data",
                  type: "text",
                  label: "Data do Evento",
                  placeholder: "dd/mm/aaaa",
                  required: false,
                },
                {
                  name: "convidados",
                  type: "number",
                  label: "Número de Convidados",
                  placeholder: "Ex: 150",
                  required: false,
                },
              ],
            },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- ═══ LOCALIZAÇÃO ═══ -->
  <section class="localizacao reveal" id="localizacao">
    <div class="container container--narrow">
      <span class="eyebrow eyebrow--dark">Como chegar</span>
      <h2>Litoral Norte</h2>
      <p class="lead">Localizado em São Sebastião, o Ágape reúne acessibilidade, cenário natural e exclusividade em um dos destinos mais desejados do litoral paulista.</p>
    </div>
    <div class="localizacao__map">
      <Img src="mapa.jpeg" alt="Localização do Ágape Celebration — Av. Guarda Mor Lobo Viana, 1038, São Sebastião" />
    </div>
    <p class="localizacao__address">
      Av. Guarda Mor Lobo Viana, 1038 &nbsp;—&nbsp; Centro, São Sebastião – SP,
      11600-000
    </p>
  </section>

  <!-- ═══ POPUP PRÉ-WHATSAPP ═══ -->
  <div class="wa-backdrop" id="waBackdrop" aria-hidden="true"></div>
  <div class="wa-popup" id="waPopup" role="dialog" aria-modal="true" aria-labelledby="waPopupTitle">

    <!-- Cabeçalho estilo WhatsApp -->
    <div class="wa-popup__head">
      <div class="wa-popup__avatar">
        <img src={logoWaIcon.src} alt="Ágape" />
      </div>
      <div class="wa-popup__info">
        <strong id="waPopupTitle">Ágape Celebration</strong>
        <span class="wa-popup__status">
          <span class="wa-popup__dot"></span>Online
        </span>
      </div>
      <button class="wa-popup__close" id="waPopupClose" aria-label="Fechar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <!-- Área de conversa -->
    <div class="wa-popup__body" style={`background-image: url('${fundoWaUrl}')`}>

      <!-- Bolha de mensagem recebida -->
      <div class="wa-bubble">
        <p>Olá, vamos conversar?</p>
        <p>Por favor, preencha as informações a seguir e vamos iniciar nossa conversa no WhatsApp.</p>
        <p>Estamos ansiosos para saber mais sobre seu evento! 🎉</p>
      </div>

      <!-- Indicador de etapas -->
      <div class="wa-steps">
        <span class="wa-step wa-step--active" id="waStep1Dot">①</span>
        <span class="wa-step-line"></span>
        <span class="wa-step" id="waStep2Dot">②</span>
      </div>

      <!-- Formulário -->
      <form
        id="waForm"
        data-project="casamentos"
        data-submit-url={config.forms["lead-form"].webhooks[0]}
        novalidate
      >
        <input type="text" name="website" class="wa-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <!-- Etapa 1: dados de contato -->
        <div id="waStep1" class="wa-step-fields">
          <input class="wa-input" id="waNome" name="nome" type="text" placeholder="Nome completo" required autocomplete="name" />
          <input class="wa-input" id="waTelefone" name="telefone" type="tel" placeholder="(00) 00000-0000" required autocomplete="tel" />
          <input class="wa-input" id="waEmail" name="email" type="email" placeholder="E-mail" required autocomplete="email" />
        </div>

        <!-- Etapa 2: dados do evento -->
        <div id="waStep2" class="wa-step-fields" style="display:none">
          <input class="wa-input" id="waData" name="data" type="text" placeholder="Data do evento (dd/mm/aaaa)" />
          <input class="wa-input" id="waConvidados" name="convidados" type="number" placeholder="Número de convidados" />
        </div>

        <p class="wa-error" id="waError" style="display:none"></p>

        <button class="wa-submit" type="button" id="waNextBtn">Seguir</button>
        <button class="wa-submit wa-submit--send" type="button" id="waSubmitBtn" style="display:none">
          <span class="wa-submit__text">Enviar e continuar no WhatsApp</span>
          <span class="wa-submit__loading" style="display:none">Enviando…</span>
        </button>
      </form>
    </div>
  </div>

  <!-- Botão flutuante WhatsApp -->
  <button class="wa-float" id="waFloat" aria-label="Fale pelo WhatsApp">
    <img src={iconeWaUrl} alt="WhatsApp" width="58" height="58" />
  </button>

  <!-- ═══ FOOTER ═══ -->
  <footer class="footer">
    <div class="footer__inner">
      <img
        src="/images/logo-areia.png"
        alt="Ágape Celebration & Convention"
        class="footer__logo"
        height="60"
      />
      <p>São Sebastião &nbsp;·&nbsp; Litoral Paulista</p>
      <a href="#contato" class="btn btn--ghost">Solicite orçamento</a>
    </div>
    <div class="footer__bottom">
      <p>
        &copy; 2026 Ágape Celebration & Convention. Todos os direitos
        reservados.
      </p>
      <a
        href="https://dmove.com.br/"
        target="_blank"
        rel="noopener noreferrer"
        class="footer__dmove"
      >
        Desenvolvido por <img
          src="/images/logo.dmove.avif"
          alt="Dmove"
          class="footer__dmove-logo"
        />
      </a>
    </div>
  </footer>
</Base>
<script>
  import "../scripts/agape-landing-v4-2.js";
</script>

<script>
  const WA_NUMBER  = '5512997526185';
  const WA_MESSAGE = 'Olá! Gostaria de receber mais informações sobre o espaço Ágape Celebration para o meu evento.';

  const backdrop   = document.getElementById('waBackdrop')!;
  const popup      = document.getElementById('waPopup')!;
  const closeBtn   = document.getElementById('waPopupClose')!;
  const floatBtn   = document.getElementById('waFloat')!;
  const form       = document.getElementById('waForm') as HTMLFormElement;
  const errorEl    = document.getElementById('waError')!;
  const step1El    = document.getElementById('waStep1')!;
  const step2El    = document.getElementById('waStep2')!;
  const step1Dot   = document.getElementById('waStep1Dot')!;
  const step2Dot   = document.getElementById('waStep2Dot')!;
  const nextBtn    = document.getElementById('waNextBtn') as HTMLButtonElement;
  const submitBtn  = document.getElementById('waSubmitBtn') as HTMLButtonElement;
  const btnText    = submitBtn.querySelector<HTMLElement>('.wa-submit__text')!;
  const btnLoad    = submitBtn.querySelector<HTMLElement>('.wa-submit__loading')!;

  function openPopup() {
    backdrop.classList.add('is-open');
    popup.classList.add('is-open');
    const first = form.querySelector<HTMLElement>('input:not(.wa-hp)');
    setTimeout(() => first?.focus(), 50);
  }

  function closePopup() {
    backdrop.classList.remove('is-open');
    popup.classList.remove('is-open');
  }

  floatBtn.addEventListener('click', openPopup);
  closeBtn.addEventListener('click', closePopup);
  backdrop.addEventListener('click', closePopup);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closePopup(); });

  // Máscara de telefone
  const telInput = form.querySelector<HTMLInputElement>('[name="telefone"]')!;
  telInput.addEventListener('input', () => {
    let v = telInput.value.replace(/\D/g, '').slice(0, 11);
    if (v.length > 7)      v = `(${v.slice(0,2)}) ${v.slice(2,7)}-${v.slice(7)}`;
    else if (v.length > 2) v = `(${v.slice(0,2)}) ${v.slice(2)}`;
    else if (v.length > 0) v = `(${v}`;
    telInput.value = v;
  });

  // Avançar etapa 1 → 2
  nextBtn.addEventListener('click', () => {
    errorEl.style.display = 'none';
    let firstInvalid: HTMLElement | null = null;
    let valid = true;
    step1El.querySelectorAll<HTMLElement>('[required]').forEach((f) => {
      const empty = !(f as HTMLInputElement).value.trim();
      if (empty) {
        valid = false;
        (f as HTMLElement).style.borderColor = '#ef4444';
        if (!firstInvalid) firstInvalid = f;
        const clear = () => { (f as HTMLElement).style.removeProperty('border-color'); f.removeEventListener('input', clear); };
        f.addEventListener('input', clear);
      }
    });
    if (!valid) { firstInvalid!.focus(); return; }

    step1El.style.display = 'none';
    step2El.style.display = 'flex';
    nextBtn.style.display = 'none';
    submitBtn.style.display = 'flex';
    step1Dot.classList.remove('wa-step--active');
    step2Dot.classList.add('wa-step--active');
    (step2El.querySelector('input') as HTMLElement)?.focus();
  });

  // Submissão
  async function handleSubmit() {
    const hp = form.querySelector<HTMLInputElement>('[name="website"]');
    if (hp?.value) return;

    submitBtn.disabled = true;
    btnText.style.display = 'none';
    btnLoad.style.display = 'inline';
    errorEl.style.display = 'none';

    const formData = new FormData(form);
    const raw: Record<string, string> = {};
    formData.forEach((v, k) => { if (k !== 'website') raw[k] = v.toString(); });

    const trackingRaw = sessionStorage.getItem('dmove_tracking');
    const tracking: Record<string, string> = trackingRaw ? JSON.parse(trackingRaw) : {};
    const now = new Date();

    const capitalized: Record<string, string> = {};
    Object.entries(raw).forEach(([k, v]) => {
      if (k === 'fonte') return;
      capitalized[k.charAt(0).toUpperCase() + k.slice(1)] = v;
    });

    const paramKeys = ['utm_source','utm_medium','utm_campaign','utm_term','utm_content','utm_id','gclid','gbraid','wbraid','fbclid','ttclid','msclkid','sck','fbc','fbp','external_id','event_id'];
    const qs = new URLSearchParams();
    paramKeys.forEach(k => { if (tracking[k]) qs.set(k, tracking[k]); });
    const submitUrl = form.dataset.submitUrl!;
    const fonte = qs.toString() ? `${submitUrl}?${qs.toString()}` : submitUrl;

    const metaCapi: Record<string,string> = {};
    if (tracking['fbc'])         metaCapi['fbc']         = tracking['fbc'];
    if (tracking['fbp'])         metaCapi['fbp']         = tracking['fbp'];
    if (tracking['external_id']) metaCapi['external_id'] = tracking['external_id'];
    if (tracking['event_id'])    metaCapi['event_id']    = tracking['event_id'];

    const payload = {
      ...capitalized,
      Fonte: fonte,
      Data: now.toLocaleDateString('pt-BR'),
      'Horário': now.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }),
      'URL da página': window.location.href,
      'Agente de usuário': navigator.userAgent,
      'IP remoto': '',
      'Desenvolvido por': 'Dmove',
      form_id: 'whatsapp-form',
      form_name: 'whatsapp-form',
      ...metaCapi,
    };

    try {
      const res = await fetch(submitUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error('http_' + res.status);

      (window as any).dataLayer?.push({ event: 'form_submit', form_id: 'whatsapp-form', project: form.dataset.project, ...capitalized });

      const encoded = encodeURIComponent(WA_MESSAGE);
      const waUrl = WA_NUMBER
        ? `https://wa.me/${WA_NUMBER}?text=${encoded}`
        : `https://wa.me/?text=${encoded}`;
      window.open(waUrl, '_blank', 'noopener,noreferrer');
      closePopup();
    } catch (err: any) {
      (window as any).dataLayer?.push({ event: 'form_error', form_id: 'whatsapp-form', error: err.message });
      errorEl.textContent = 'Erro ao enviar. Tente novamente mais tarde.';
      errorEl.style.display = 'block';
      submitBtn.disabled = false;
      btnText.style.display = 'inline';
      btnLoad.style.display = 'none';
    }
  }

  submitBtn.addEventListener('click', handleSubmit);

  form.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return;
    const target = e.target as HTMLElement;
    if (target.tagName === 'TEXTAREA' || target.tagName === 'BUTTON') return;
    e.preventDefault();
    if (step2El.style.display === 'none') {
      nextBtn.click();
    } else {
      handleSubmit();
    }
  });
</script>

